<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/base_url_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/api_key_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/model_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/persona_label"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/rg_persona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_persona_warm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/persona_warm"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb_persona_steady"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/persona_steady"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb_persona_witty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/persona_witty"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/voice_engine_label"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/rg_voice_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_voice_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_system"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb_voice_xfyun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_xfyun"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/xfyun_app_id_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_xfyun_app_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/xfyun_api_key_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_xfyun_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/xfyun_api_secret_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_xfyun_api_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/xfyun_voice_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_xfyun_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/voiceprint_label"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_voiceprint_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <!-- Voiceprint enrollment saves immediately, like the crash-log
             button: it does not wait for Settings OK/Cancel. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_voiceprint_enroll"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/voiceprint_enroll"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_voiceprint_clear"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/voiceprint_clear"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_hint"
            android:textColor="#9E9E9E"
            android:textSize="14sp" />

        <!-- Diagnostics: crash.log lives in private files; this button is
             the only way to see it on-device (no auto-upload ever). -->
        <Button
            android:id="@+id/btn_crash_log"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/crash_log_button"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
